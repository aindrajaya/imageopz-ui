# VITE_IMAGEOPZ_API_BASE_URL: Optional backend base URL.
# If omitted/empty, the UI will call the API on the same origin (e.g. behind a reverse proxy).
# Examples:
# - Local backend: http://localhost:8000
# - Remote backend: https://api.imageopz.example
VITE_IMAGEOPZ_API_BASE_URL=""
# Local dev helper: route API calls through Vite proxy to avoid CORS preflights.
# When true (dev only), frontend will call `/api/...` on the Vite origin and Vite will proxy to `VITE_IMAGEOPZ_API_BASE_URL`.
VITE_IMAGEOPZ_USE_VITE_PROXY="false"
# Send the session cookie on API requests (credentials: "include"). Default when omitted: true.
# Set "false" to rely on the X-Session-Id header only (e.g. cross-site API without cookie support).
VITE_IMAGEOPZ_SEND_COOKIES="true"

# Supabase Magic Link Auth (optional)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# If omitted, defaults to `${window.location.origin}/auth/callback`
VITE_SUPABASE_REDIRECT_URL=""

# PostHog product analytics (public project token, safe to ship to the browser)
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=""
VITE_PUBLIC_POSTHOG_HOST=""
