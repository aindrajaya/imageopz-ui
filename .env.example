# All VITE_ variables are compiled into the browser bundle: public values only, never secrets.
# Per-environment values (Production, staging, Preview): docs/engineering/deploy/UI-ENVIRONMENTS.md.
# All of them are read in lib/config.ts.

# Backend base URL, no trailing slash. Required in production builds (otherwise the UI shows a "not configured" screen).
# Examples:
# - Local backend: http://localhost:8000
# - Cloud Run: https://imageopz-api-<env>-<PROJECT_NUMBER>.asia-northeast1.run.app
VITE_IMAGEOPZ_API_BASE_URL=""
# Local dev helper: route API calls through Vite proxy to avoid CORS preflights.
# When true (dev only), frontend will call `/api/...` on the Vite origin and Vite will proxy to `VITE_IMAGEOPZ_API_BASE_URL`.
VITE_IMAGEOPZ_USE_VITE_PROXY="false"
# "false": header-only sessions (X-Session-Id, credentials "omit" on every API call) - use for prod, staging, preview.
# Anything else or unset: also send the session cookie (credentials "include").
VITE_IMAGEOPZ_SEND_COOKIES="true"

# Supabase Magic Link Auth. Required in production builds (URL and anon key); optional for local dev (sign-in off).
# Anon/publishable key only - never the service-role key.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# If omitted, defaults to `${window.location.origin}/auth/callback`
VITE_SUPABASE_REDIRECT_URL=""

# PostHog product analytics (public project token, safe to ship to the browser). Empty token = analytics off.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=""
VITE_PUBLIC_POSTHOG_HOST=""
